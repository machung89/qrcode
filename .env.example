# Domain chính của website (dùng cho canonical, hreflang, sitemap)
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=QR Code Generator

# Mật khẩu đăng nhập trang /admin
ADMIN_PASSWORD=change-me
# Chuỗi bí mật ngẫu nhiên dùng để ký cookie phiên đăng nhập
ADMIN_SECRET=please-change-this-to-a-long-random-string

# Đăng nhập Google cho người dùng (Google Cloud Console > APIs & Services > Credentials > OAuth client ID)
# Authorized redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
