# Chép thành .env.local để chạy trên máy (npm run dev).
# Trên Cloudflare: biến NEXT_PUBLIC_* và SITE_META_TAGS đặt ở "Build variables";
# ADMIN_PASSWORD, ADMIN_SECRET, GOOGLE_* đặt bằng `npx wrangler secret put <TÊN>`.

# Domain chính của website (dùng cho canonical, hreflang, sitemap, link QR động)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=QR Code Generator

# Mật khẩu đăng nhập trang /admin
ADMIN_PASSWORD=change-me
# Chuỗi bí mật ngẫu nhiên dùng để ký cookie admin và băm IP lượt quét
ADMIN_SECRET=please-change-this-to-a-long-random-string

# Đăng nhập Google (Google Cloud Console > APIs & Services > Credentials > OAuth client ID)
# Authorized redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (Tuỳ chọn) Thẻ meta xác minh website, dạng "tên=giá trị;tên2=giá trị2"
# vd: google-adsense-account=ca-pub-1234567890123456;google-site-verification=abc
SITE_META_TAGS=
